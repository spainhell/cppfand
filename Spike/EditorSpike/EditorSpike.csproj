<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike: da se textovy editor PC-FANDu nahradit beznou WPF komponentou?
       Samostatna aplikace, do interpretu nesaha. Neni v cppfand.sln. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>editor-spike</AssemblyName>
    <RootNamespace>EditorSpike</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <None Update="vzorek-help.t00" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vzorek-atributy.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
