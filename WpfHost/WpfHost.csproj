<Project Sdk="Microsoft.NET.Sdk">

  <!-- WpfHost: okenni hostitel interpretu cppfand.
       Interpret bezi v cppfand_dll.dll na vlastnim vlakne, tato aplikace
       kresli jeho obrazovku 80x25 jako mrizku znaku, posila mu klavesy
       a editaci jednoradkovych poli prebira do bezneho WPF TextBoxu
       (schranka, oznaceni mysi, maskovane datum). Viz Drivers/host.h.

       Stavi se pro .NET Framework 4.8 (soucast Windows 10/11, klient nic
       neinstaluje) i pro .NET 10. Vystup: x64\<Configuration>\wpf\<TFM>\ -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>cppfand-wpf</AssemblyName>
    <RootNamespace>WpfHost</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputPath>..\x64\$(Configuration)\wpf\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- .NET Framework: dialog pro vyber slozky je jen ve Windows Forms -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Net.Http" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- nativni DLL ze stejne konfigurace solution (x64\Debug|Release) -->
  <ItemGroup>
    <None Include="..\x64\$(Configuration)\cppfand_dll.dll" Link="cppfand_dll.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
