<Window x:Class="WpfHost.SendMailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odeslat e-mailem" Width="520" Height="380" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Komu:" Target="{Binding ElementName=ToBox}"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ToBox" Margin="0,3" ToolTip="víc adres oddělte čárkou nebo středníkem"/>
            <Label Grid.Row="1" Content="Předmět:" Target="{Binding ElementName=SubjectBox}"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SubjectBox" Margin="0,3"/>
            <Label Grid.Row="2" Content="Příloha:"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AttachmentText" VerticalAlignment="Center" Margin="0,3"/>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#555"/>
            <Button x:Name="SendButton" Content="Odeslat" Width="90" IsDefault="True" Click="Send_Click"/>
            <Button Content="Zrušit" Width="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <TextBox x:Name="BodyBox" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
