<Window x:Class="WpfHost.TextEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Text" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- tisk a export; v nápovědě skrytý -->
        <ToolBar x:Name="OutputBar" DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <Button Content="Tisk… (F6)" Click="Print_Click" ToolTip="Vytisknout na tiskárně Windows"/>
            <Separator/>
            <Button Content="PDF…" Click="SavePdf_Click" ToolTip="Uložit jako PDF"/>
            <Button Content="Word…" Click="SaveDocx_Click" ToolTip="Uložit jako dokument Word (DOCX)"/>
            <Button Content="ODT…" Click="SaveOdt_Click" ToolTip="Uložit jako OpenDocument (LibreOffice)"/>
            <Separator/>
            <Button Content="E-mailem…" Click="Email_Click" ToolTip="Odeslat jako PDF přílohu"/>
            <Button Content="Nastavení e-mailu…" Click="MailSettings_Click"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="PosText" Text="–"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="AttrText" Text="–"/></StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="HintText" Foreground="#666"
                           Text="F12 řídicí znaky · F2 uložit a zavřít · Esc zavřít"/>
            </StatusBarItem>
        </StatusBar>

        <avalon:TextEditor x:Name="Editor"
                           FontFamily="Consolas" FontSize="16"
                           ShowLineNumbers="True"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
